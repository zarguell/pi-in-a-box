# =============================================================================
# pi-in-a-box — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Dashboard ---
# Port the dashboard binds to on the Docker host (default: 8000)
PIAB_PORT=8000

# --- Model Provider ---
# Set ONE or more provider API keys. Pi reads these natively.
# Examples for common providers (uncomment what you use):

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GOOGLE_API_KEY=...

# Fireworks AI
# FIREWORKS_API_KEY=...

# OpenRouter
# OPENROUTER_API_KEY=sk-or-...

# --- Pi Configuration ---
# Pi home directory inside the container (default: /data/pi-home)
# PIAB_PI_HOME=/data/pi-home

# --- Extension Enable/Disable ---
# Control which optional extensions are installed at build time.
# Core extensions (subagents, goal, skillful, prompt-template-model, btw) are always included.

# Browser automation — Chromium + pi-agent-browser-native
PIAB_BROWSER_ENABLED=false

# Safety guards — safe-coder project guardrails
PIAB_ENABLE_SAFETY_GUARDS=true

# Crew orchestration — pi-crew for worktrees and multi-agent task graphs
PIAB_ENABLE_CREW=false

# Ralph-style loops — pi-extensions long-running autonomous loops
PIAB_ENABLE_RALPH=false

# --- Extension Versions (optional, override defaults) ---
# PIAB_VERSION_PI=0.84.2
# PIAB_VERSION_DASHBOARD=0.7.0
# PIAB_VERSION_SUBAGENTS=0.52.0
# PIAB_VERSION_GOAL=0.6.0
# PIAB_VERSION_BROWSER_NATIVE=0.3.0
# PIAB_VERSION_SKILLFUL=latest
# PIAB_VERSION_PROMPT_TEMPLATE_MODEL=latest
# PIAB_VERSION_BTW=latest

# --- User/Group ID (optional, for host permission alignment) ---
# PUID=1001
# PGID=1001
